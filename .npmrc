# npm reads .npmrc from the root and the cwd, never from a workspace package, so
# the copy the scaffold ships in packages/hardhat/.npmrc is ignored by the root
# `npm install` every user actually runs. Without this line the install fails:
# hardhat is pinned to 2.22.19 while @nomicfoundation/hardhat-verify@2.1.3 wants
# peer hardhat@^2.26.0.
#
# Kept here rather than bumping hardhat, because the pin is the scaffold's and
# the Hedera plugin set is tested against it.
legacy-peer-deps=true
